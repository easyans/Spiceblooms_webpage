{
  "rewrites": [
    {
      "source": "/spiceblooms-logo.svg",
      "destination": "/assets/spiceblooms-logo.svg"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
